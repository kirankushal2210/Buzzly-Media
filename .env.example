# ── Public site ────────────────────────────────────────────────────────────────
# Production origin, no trailing slash. Used for canonical URLs, sitemap, share images.
# REQUIRED in production. Live origin is https://www.buzzly.in (apex 308-redirects to www,
# so always use the www form). buzzly.media is NOT ours — it belongs to an unrelated UK agency.
NEXT_PUBLIC_SITE_URL=https://www.buzzly.in
# Intro-call booking page (Cal.com / Calendly). Button is hidden while empty.
NEXT_PUBLIC_BOOKING_URL=
# WhatsApp Business number, digits only with country code (e.g. 919876543210). Button hidden while empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Comma-separated official profile URLs for the Organization schema (sameAs).
NEXT_PUBLIC_SOCIAL_LINKS=

# ── Lead delivery: configure at least ONE (two or more recommended) ───────────
# Telegram bot (free, no email needed): token from @BotFather, chat id from getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack / Discord incoming webhooks.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# Generic JSON webhook (Google Apps Script, Zapier, Make, n8n) e.g. to append leads to a Google Sheet.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# Email via Resend. Without a business domain use CONTACT_FROM_EMAIL=onboarding@resend.dev
# and CONTACT_TO_EMAIL=<the email of your Resend account> (free tier; auto-reply needs a verified domain).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# "true" to email the visitor a confirmation (requires verified Resend sender).
CONTACT_AUTO_REPLY=false

# ── Security / maintainer ─────────────────────────────────────────────────────
# Long random string for hashing visitor IPs (openssl rand -hex 32).
CONTACT_IP_SALT=
# Long random string (>= 16 chars) that unlocks /api/admin/health and /api/admin/inquiries.
MAINTAINER_TOKEN=

# ---------- CRM (/admin) ----------
# Admin login password (at least 12 characters). Required for /admin.
ADMIN_PASSWORD=
# Optional: separate key for signing admin sessions (otherwise derived from the password).
ADMIN_SESSION_SECRET=
# Postgres connection string. Added automatically when you create a Neon / Vercel Postgres
# database in Vercel → Storage. Without it, local development uses an in-memory database saved to .data/crm-local.tar.gz.
DATABASE_URL=
