# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings → Environment Variables instead.
# Only NEXT_PUBLIC_ variables reach the browser; everything else stays on the server.

# --- Public site -------------------------------------------------------------
# Production origin, no trailing slash. Used for canonical URLs, sitemap and share cards.
NEXT_PUBLIC_SITE_URL=https://buzzly.in

# --- Intro-call booking (optional) --------------------------------------------
# Cal.com event shown on /book, e.g. "buzzly/intro-call" (or the full cal.com URL).
# Public by design. Until set, /book shows "online booking opens soon" with a link to /contact.
NEXT_PUBLIC_CAL_LINK=

# --- Inquiry database (required to accept inquiries) -------------------------
# Supabase → Project Settings → API. The contact form shows "inbox being set up"
# and rejects submissions until both are set.
SUPABASE_URL=
# Secret key (sb_secret_...). Server-only: it bypasses Row Level Security.
# NEVER rename it with a NEXT_PUBLIC_ prefix or use it in client code.
# (A legacy service_role key also works via SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=

# --- Inquiry notifications (optional; each channel is skipped when unset) ----
# Email via Resend (resend.com → API Keys). Server-only: never NEXT_PUBLIC_, never commit it.
RESEND_API_KEY=
# Inbox that receives new inquiries (Reply-To is set to the visitor). Change it any time;
# several addresses can be comma-separated. Keep the real value in .env.local / Vercel only.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Buzzly <hello@yourdomain.com>".
# Until a domain is verified you can use "Buzzly <onboarding@resend.dev>": Resend then only
# delivers to the Resend account owner's own address, and visitor confirmations are skipped.
CONTACT_FROM_EMAIL=
# Incoming-webhook URLs (hooks.slack.com/services/... and discord.com/api/webhooks/...).
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# Visitor confirmation email ("we've received your inquiry"). On by default; "false" turns it off.
CONTACT_AUTO_REPLY=true

# --- Abuse prevention ----------------------------------------------------------
# Long random string used to hash visitor IPs for rate limiting. Keep it stable.
CONTACT_IP_SALT=
