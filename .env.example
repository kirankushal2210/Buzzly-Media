# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings → Environment Variables instead.
# Only NEXT_PUBLIC_ variables reach the browser; everything else stays on the server.

# --- Public site -------------------------------------------------------------
# Production origin, no trailing slash. Used for canonical URLs, sitemap and share cards.
NEXT_PUBLIC_SITE_URL=https://buzzly.media

# --- Inquiry database (required to accept inquiries) -------------------------
# Supabase → Project Settings → API. The contact form shows "inbox being set up"
# and rejects submissions until both are set.
SUPABASE_URL=
# Secret key (sb_secret_...). Server-only: it bypasses Row Level Security.
# NEVER rename it with a NEXT_PUBLIC_ prefix or use it in client code.
# (A legacy service_role key also works via SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=

# --- Inquiry notifications (optional; each channel is skipped when unset) ----
# Email via Resend. CONTACT_TO_EMAIL is the inbox that receives new inquiries.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "Buzzly <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
# Incoming-webhook URLs (hooks.slack.com/services/... and discord.com/api/webhooks/...).
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# "true" sends the visitor a generic confirmation email after the team is notified.
CONTACT_AUTO_REPLY=false

# --- Abuse prevention ----------------------------------------------------------
# Long random string used to hash visitor IPs for rate limiting. Keep it stable.
CONTACT_IP_SALT=
